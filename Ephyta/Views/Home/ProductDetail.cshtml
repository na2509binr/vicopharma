        <div class="product-detail-content " id="thong-tin-san-pham">
            <div class="title title-global">THÔNG TIN SẢN PHẨM</div>
            <div class="content-detail mt-4">
                <div class="content">
                    @Html.Raw(Model.Product.Intro)
                </div>
                <div class="see-open active mt-3">Xem thêm <i class="fas fa-angle-double-right"></i></div>
                <div class="see-close mt-3">
                    Thu gọn <i class="fas fa-angle-double-right"></i></a>
                </div>
            </div>
        </div>
        @if (Model.Product.Usermanual != null)
        {
            <div class="user-manual">
                <div class="title title-global collapsed" data-toggle="collapse" data-target="#tab-1">
                    HƯỚNG DẪN SỬ DỤNG
                    <i class="far fa-chevron-down down"></i>
                    <i class="far fa-chevron-up up"></i>
                </div>
                <div class="content-detail mt-4 collapse" id="tab-1">
                    @Html.Raw(Model.Product.Usermanual)
                </div>

            </div>
        }
        @if (Model.Product.Ingredient != null)
        {
            <div class="product-ingredient">
                <div class="title title-global collapsed" data-toggle="collapse" data-target="#tab-2">
                    THÀNH PHẦN
                    <i class="far fa-chevron-down down"></i>
                    <i class="far fa-chevron-up up"></i>
                </div>
                <div class="content-detail mt-4 collapse" id="tab-2">
                    @Html.Raw(Model.Product.Ingredient)
                </div>

            </div>
        }

        @if (Model.ReviewKols.Any())
        {
            <div class="product-review mt-4">
                <div class="title title-global mb-2">KOl review</div>
                <div class="product-review-list owl-carousel">
                    @foreach (var item in Model.ReviewKols)
                    {
                        <div class="product-review-item">
                            <div class="item">
                                @if (item.VideoLink != null && item.VideoLink != "")
                                {
                                    <div class="embed-responsive embed-responsive-16by9 video-item">
                                        @Html.ShowYoutubeLazy(item.VideoLink, 600, 400)
                                    </div>
                                }
                                else
                                {
                                    if (item.Image != null)
                                    {
                                        <img src="@Path.Combine("/images/reviewKols/", item.Image)" />
                                    }
                                    else
                                    {
                                        <img src="~/Content/images/no-image.jpg" />
                                    }
                                }
                                <div class="name">
                                    @item.Name
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>

        }
    </div>
</section>


<section class="related-products mb-4">
    <div class="container">
        <div class="title title-global">SẢN PHẨM LIÊN QUAN</div>
        <div class="row mt-4 row-mb-10">
            @foreach (var item in Model.Products)
            {
                <div class="col-lg-3 col-6">
                    @Html.Partial("_ItemProduct", item)
                </div>
            }
        </div>
    </div>
</section>

<section class="product-hot">
    <div class="container">
        <div class="title title-global">Sản phẩm bán chạy nhất</div>
        <div class="row mt-4 row-mb-10">
            @foreach (var item in Model.ProductHot)
            {
                <div class="col-lg-3 col-6">
                    @*@Html.Partial("_ItemProduct", item)*@
                    @Html.Action("ItemProduct", "Home", new { id = item.Id })
                </div>
            }
        </div>
    </div>
</section>

<section class="reviews-customers mt-lg-5 mt-4" id="reviews-customers">
    <div class="container">
        <div class="top">
            <div class="title">ĐÁNH GIÁ TỪ KHÁCH HÀNG ĐÃ MUA</div>
            <div class="right">
                <div class="reviews-star">
                    <div class="d-flex align-items-center">
                        <div class="number">@Model.Rating</div>
                        <div class="rating mr-2" data-default-rating="@Model.Rating" disabled></div>
                    </div>
                    <span>Theo @Model.Reviews.Count() đánh giá</span>
                </div>
                <div class="btn-comment">
                    <a href="@Url.Action("FormComment", new{url = Model.Product.Url})" data-fancybox data-type="ajax" data-touch="false">
                        VIẾT ĐÁNH GIÁ
                        <img src="~/Content/images/pen.png" class="ml-2" />
                    </a>
                </div>
            </div>
        </div>
        <div id="reviews-list" class="content">
            @Html.Action("GetReview", "Home", new { id = Model.Product.Id })
        </div>
    </div>
</section>

@*@Html.Action("FormComment")*@



@section scripts{
    <script src="~/Scripts/jquery.nice-number.js"></script>
    <script language="javascript" type="text/javascript">

        $(document).ready(function () {

            $(document).on("click", "#contentPager a[href]", function () {

                $.ajax({

                    url: $(this).attr("href"),

                    type: 'GET',

                    cache: false,

                    success: function (result) {

                        $('#reviews-list').html(result);
                        var t = $('#reviews-list').position().top; //lấy vị trí của phần trang web gán cho biến t
                        $('html,body').stop().animate({ scrollTop: t }); //cuộn trang đến phần với biến t
                    }

                });

                return false;

            });

        });

    </script>
    <script>
        ProductDetailJs();
    </script>
}