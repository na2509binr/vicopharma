@model Ephyta.ViewModel.CategoryProductViewModel
@using PagedList.Mvc
@{
    ViewBag.Title = "Tất cả sản phẩm";
    ViewBag.Description = "Tất cả sản phẩm của ";
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("AllProductCategory");
    if (Model.Products.Any())
    {
        var fp = Model.Products.First();
        ViewBag.ImagShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Path.Combine("/images/products/", fp.ListImage.Split(',')[0]);
    }
}
<div class="bg-breadcrumb">
    <div class="container">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sản phẩm </li>
        </ol>
    </div>
</div>
<div class="page-product">
    <div class="container py-3">

        <div class="row  mt-3">
            <div class="col-12 col-lg-3 order-lg-0 order-1 order-1 mt-lg-0 mt-3" data-aos="fade-up" data-aos-duration="800">
                @Html.Action("MenuProduct")
            </div>
            <div class="col-12 col-lg-9 order-lg-1 order-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h1 class="name-category">SẢN PHẨM CỦA - EPHYTA</h1>
                    <div class="filter">
                        <form action="" method="get" class="ml-2">
                            <select class="custom-select filter-select mt-0" name="Sort" onchange="$(this).parents('form').submit();">
                                <option value="new">Mới đăng</option>
                                <option value="order-desc" @if (Model.Sort == "order-desc") { @Html.Raw("selected='selected'") }>Thứ tự</option>
                                <option value="name" @if (Model.Sort == "name") { @Html.Raw("selected='selected'") }>Tên a-z</option>
                                <option value="price" @if (Model.Sort == "price") { @Html.Raw("selected='selected'") }>Giá thấp đến cao</option>
                                <option value="price-desc" @if (Model.Sort == "price-desc") { @Html.Raw("selected='selected'") }>Giá cao đến thấp</option>
                            </select>
                        </form>
                    </div>
                </div>
                @if (Model.Products.Any())
                {
                    <div class="row row-gutter-5">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-lg-3 col-6">
                                @Html.Action("ItemProduct", "Home", new { id = product.Id })
                            </div>
                        }

                    </div>
                    if (Model.Products.PageCount > 1)
                    {
                        <div id="contentPager" class=" mt-lg-5 mt-3 ">
                            @Html.PagedListPager(Model.Products, page => Url.Action("AllProductCategory", new { page }))
                        </div>
                    }
                }
                else
                {
                    <p class=" mt-lg-4 mt-3  alert alert-info small">Nội dung hiện chưa được cập nhật.Vui lòng quay lại sau !!!</p>
                }
            </div>
        </div>
    </div>
</div>
