@using Ephyta.Models
@model Contact
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    ViewBag.Title = "Liên hệ";
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("Contact");

}
<div class="bg-gray">
    <div class="container">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")"><i class="fal fa-home"></i></a></li>
            <li class="breadcrumb-item active" aria-current="page">Liên hệ</li>
        </ol>
    </div>
</div>
@if (config.GoogleMap != null)
{
    <div class="container-fluid aos-init aos-animate mt-3 mt-lg-5" data-aos="zoom-in" data-aos-duration="1200">
        <div class="embed-responsive embed-responsive-16by9 map">
            @Html.Raw(config.GoogleMap)
        </div>
    </div>
}
<div class="container py-lg-5 py-3">
    <div class="contact">
        <div class="title mb-3">
            Gửi liên hệ cho chúng tôi
        </div>
        <form id="contact_form" class="contact-form pt-3 pt-lg-5">
            @Html.ValidationSummary(true)
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-sm-12 col-lg-6">
                    <div class="form-row">
                        <div class="col">
                            @Html.TextBoxFor(model => model.Fullname, new { @class = "form-control", placeholder = "Họ và tên", required = "" })
                            @Html.ValidationMessageFor(model => model.Fullname)
                        </div>
                        <div class="col">
                            @Html.TextBoxFor(model => model.Mobile, new { @class = "form-control", placeholder = "Điện thoại", required = "" })
                            @Html.ValidationMessageFor(model => model.Mobile)
                        </div>
                    </div>
                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", placeholder = "Email", required = "" })
                    @Html.ValidationMessageFor(model => model.Email)
                    @Html.TextBoxFor(model => model.Address, new { @class = "form-control", placeholder = "Địa chỉ", required = "" })
                    @Html.ValidationMessageFor(model => model.Address)
                </div>
                <div class="col-sm-12 col-lg-6">
                    <div class="form-group">
                        @Html.TextAreaFor(model => model.Body, new { @class = "form-control", rows = 4, placeholder = "Yêu cầu thêm" })
                        @Html.ValidationMessageFor(model => model.Body)
                    </div>
                    <button type="submit" class="btn btn-style btn-style--cart"> <span>Gửi đi</span></button>
                </div>
            </div>
        </form>
    </div>
</div>
