@model Ephyta.ViewModel.HomeViewModel
@using Ephyta.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    ViewBag.Title = config.Title;
    ViewBag.Description = config.Description;
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("Index");

    var fb = Model.Banners.FirstOrDefault(c => c.GroupId == 1);
    if (fb != null)
    {
        ViewBag.ImagShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Path.Combine("/images/banners/", fb.Image);
    }
    const string img = "data:image/gif;base64,R0lGODlhAQABAIAAAAUEBAAAACwAAAAAAQABAAACAkQBADs=";
}
<h1 class="d-none">@config.Title</h1>
<section class="banner">
    <div class="banner-list">
        @foreach (var banner in Model.Banners.Where(l => l.GroupId == 1))
        {
            <a href="@banner.Url">
                <img src="@img" data-src="@Path.Combine("/images/banners/",banner.Image)" class="lazyload" alt="@banner.BannerName"/>
            </a>
        }
    </div>
</section>
@if (Model.Banners.Any(l => l.GroupId == 4))
{
    <section class="service">
        <div class="container">
            <div class="row">
                @foreach (var banner in Model.Banners.Where(l => l.GroupId == 4 && l.Image != null).Take(4))
                {
                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="service-item">

                            <img src="@Path.Combine("/images/banners/",banner.Image)" alt="@banner.BannerName" width="50"/>
                            <div class="content">
                                <div class="name">@banner.BannerName</div>
                                <div class="des">@banner.Slogan</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
@if (Model.Banners.Any(l => l.GroupId == 2))
{
    <div class="banner-product-hot">
        <div class="container-fluid">
            <div class="row row-gutter-10">
                @foreach (var banner in Model.Banners.Where(l => l.GroupId == 2 && l.Image != null))
                {
                    <div class="col-md-6">
                        <a href="@banner.Url">
                            <img src="@img" data-src="@Path.Combine("/images/banners/",banner.Image)" class="lazyload" alt="@banner.BannerName"/>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

<section class="section-product">
    <div class="container">
        <div class="text-center">
            <div class="section-title d-inline-block">Sản phẩm bán chạy nhất</div>
        </div>
        <div class="product-list">
            @foreach (var item in Model.Products)
            {
                @*@Html.Partial("_ItemProduct", item)*@

                @Html.Partial("ItemProduct", item)
            }
        </div>
    </div>
</section>

<section class="section-product position-relative">
    <div class="la-cay-1"></div>
    <div class="la-cay-2"></div>
    <div class="container">
        <div class="text-center">
            <div class="section-title d-inline-block">Khuyến mại và combo</div>
        </div>
        @foreach (var banner in Model.Banners.Where(l => l.GroupId == 5))
        {
            <a href="@banner.Url">
                <img src="@img" data-src="@Path.Combine("/images/banners/",banner.Image)" class="lazyload section-product-img img-fluid" width="1200" alt="@banner.BannerName"/>
            </a>
        }
        <div class="product-list">
            @foreach (var item in Model.ComboProducts)
            {
                @Html.Partial("ItemProduct", item)
            }

            @*@foreach (var item in Model.Products.Where(l => l.ProductCategory.TypeProduct == TypeProduct.Combo && l.SaleOff != null).Take(12))
            {
                @Html.Action("ItemProduct", "Home", new { id = item.Id })

            }*@
        </div>
    </div>
</section>

<section class="section-product">
    <div class="container">
        <div class="text-center">
            <div class="section-title d-inline-block">Danh mục sản phẩm</div>
        </div>
        @foreach (var banner in Model.Banners.Where(l => l.GroupId == 6))
        {
            <a href="@banner.Url">
                <img src="@img" data-src="@Path.Combine("/images/banners/",banner.Image)" class="lazyload section-product-img img-fluid" width="1200" alt="@banner.BannerName"/>
            </a>
        }
        <div class="product-list">
            @foreach (var item in Model.AllProducts)
            {
                @Html.Partial("ItemProduct", item)
            }
        </div>
    </div>
</section>

