<section class="news">
    <div class="container">
        <div class="text-center">
            <div class="section-title d-inline-block">Tin tức & sự kiện</div>
        </div>
        <div class="row mt-3">
            <div class="col-lg-8">
                <div class="new-slider">
                    @foreach (var item in Model.Articles.Where(l => l.Home).Take(6))
                    {
                        <div class="news-item">
                            <div class="img">
                                <a href="@Url.Action("ArticleDetail", new { url = item.Url })">
                                    @if (item.Image != null)
                                    {
                                        <img src="@img" data-src="@Path.Combine("/images/articles/",item.Image)?w=500" class="lazyload" width="500" alt="@item.ArticleCategory.CategoryName"/>
                                    }
                                    else
                                    {
                                        <img src="~/Content/images/no-image.jpg" alt="No Picture"/>
                                    }
                                </a>
                            </div>
                            <div class="body">
                                <div class="date">@item.CreateDate.ToString("dd/MM/yyy")</div>
                                <div class="name">
                                    <a href="@Url.Action("ArticleDetail", new { url = item.Url })">@item.Subject</a>
                                </div>
                                <div class="des">@item.Description</div>
                            </div>
                        </div>

                    }
                </div>
            </div>
            <div class="col-lg-4">
                @foreach (var item in Model.Articles.Where(l => l.Col).Take(3))
                {
                    <div class="new-col">
                        <div class="date">@item.CreateDate.ToString("dd/MM/yyy")</div>
                        <div class="name">
                            <a href="@Url.Action("ArticleDetail", new { url = item.Url })">@item.Subject</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="video">
    <div class="container">
        <div class="text-center mb-3">
            <div class="section-title d-inline-block">VIDEO VỀ EPHYTA</div>
        </div>
        <div class="row align-items-center">
            <div class="col-lg-7">
                @if (config.VideoIntro != null)
                {
                    var ytId = HtmlHelpers._pegarIDYoutube(config.VideoIntro);
                    <div class="media-video">
                        <div class="embed-responsive ">
                            <a href="@config.VideoIntro" data-fancybox class="">
                                <div class="play-video">
                                    <i class="fa fa-play"></i>
                                </div>
                                <div class="video-img">
                                    <img src="@img" data-src="https://i.ytimg.com/vi_webp/@ytId/maxresdefault.webp" class="img-fluid lazyload" alt="Video giới thiệu" />
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
            <div class="col-lg-5">
                @Html.Action("FormRegister")
            </div>
        </div>
    </div>
</section>

@if (Model.Feedbacks.Any())
{
    <div class="feedback lazyload" data-bg="/Content/images/feedback-bg.jpg">
        <div class="container">
            <div class="title text-center">KHÁCH HÀNG NÓI VỀ CHÚNG TÔI</div>
            <div class="feedback-list">
                @foreach (var item in Model.Feedbacks)
                {
                    <div class="feedback-item">
                        <div class="avata">
                            @if (item.Image != null)
                            {
                                <img data-src="@Path.Combine("/images/feedbacks/",item.Image)" src="@img" class="lazyload" alt="@item.Name"/>

                            }
                            else
                            {
                                <img src="~/Content/images/no-image.jpg" alt="No Picture"/>
                            }
                        </div>
                        <div class="name">@item.Name</div>
                        <div class="des">@item.Content</div>
                    </div>

                }
            </div>
        </div>
    </div>

}

<section class="partner pb-4">
    <div class="container">
        <div class="text-center mb-4">
            <div class="section-title d-inline-block">ĐỐI TÁC CỦA CHÚNG TÔI</div>
        </div>
        <div class="partner-list">
            @foreach (var banner in Model.Banners.Where(l => l.GroupId == 3))
            {
                <div class="partner-item">
                    <a href="@banner.Url">
                        <img src="@img" data-src="@Path.Combine("/images/banners/",banner.Image)?w=300" class="lazyload" alt="@banner.BannerName"/>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
@section scripts{
    <script>
        IndexJs();
    </script>
}