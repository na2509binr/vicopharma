@model Ephyta.ViewModel.CityWardsViewModel
@using PagedList.Mvc
@using Helpers
@{
    ViewBag.Title = "Thêm mới Thành phố";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2>Danh sách thành phố</h2>
<div class="box_content mt-0">
    <table class="list_table">
        <thead>
            <tr>
                <th class="text-center" style="width: 60px"></th>
                <th class="text-center">Tên tỉnh/thành</th>
                <th class="text-center">Thứ tự</th>
                <th class="text-center">Hoạt động</th>
                <th class="text-center">Loại</th>
                <th class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in Model.Cities)
            {
                <tr style="background: #f0f0f0" data-id="@city.Id" class="accordion-row">
                    <td class="text-center"><button class="accordion-btn" onclick="toggleSub(this)" style="border: none; font-size: 18px;">+</button></td>
                    <td><strong>@city.Name</strong></td>
                    <td style="width: 150px; text-align: center;">
                        <input type="number" name="CitySort" value="@city.CitySort" class="form_control" style="width: 50px;" />
                    </td>
                    <td class="text-center">@Html.CheckBoxFor(a => city.CityActive, new { @checked = "checked" })</td>
                    <td>@city.Prefix</td>
                    <td class="text-center">
                        <a href="javascript:;" onclick="updateCity('@city.Id')">Cập nhật</a>
                    </td>
                </tr>
                <tr class="sub-table-row hidden">
                    <td></td>
                    <td colspan="5">
                        <table class="sub-table" style="width: 100%">
                            <thead>
                                <tr>
                                    <th class="text-center">Tên xã/phường</th>
                                    <th class="text-center">Sắp xếp</th>
                                    <th class="text-center">Hoạt động</th>
                                    <th class="text-center">Loại</th>
                                    <th class="text-center">Phí ship</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ward in Model.GetWardsByCityId(city.Id))
                                {

                                    <tr data-id="@ward.Id">
                                        <td>@ward.Name</td>
                                        <td style="width: 150px; text-align: center;">
                                            <input type="number" name="WardSort" value="@ward.WardSort" class="form_control" style="width: 50px;" />
                                        </td>
                                        @*<td class="text-center">@ward.Sort</td>*@
                                        <td class="text-center">@Html.CheckBoxFor(a => ward.WardActive, new { @checked = "checked" })</td>
                                        <td>@ward.Prefix</td>
                                        @*<td class="text-right">@ward.ShipFee</td>*@
                                        <td class="text-right">
                                            <input id="ShipFee" type="text" name="ShipFee" value="@String.Format("{0:N0}", ward.ShipFee)" class="form_control" />
                                        </td>
                                        <td class="text-center">
                                            <a href="javascript:;" onclick="updateWard('@ward.Id')">Cập nhật</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
            @if (Model.Cities.PageCount > 1)
            {
                <tr>
                    <td colspan="8">@Html.PagedListPager(Model.Cities, page => Url.Action("ListCityPartial", new { page }))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    function toggleSub(button) {
        const row = button.closest('tr');
        const nextRow = row.nextElementSibling;
        if (nextRow && nextRow.classList.contains('sub-table-row')) {
            nextRow.classList.toggle('hidden');
            button.textContent = button.textContent === '+' ? '−' : '+';
        }
    }

    function updateCity(id) {
        var divId = $("tr[data-id='" + id + "']");
        var sort = divId.find("input[name=CitySort]").val();
        var active = divId.find("input#city_CityActive").prop("checked");


        $.post("/Vcms/UpdateCity", { cityId: id, sort, active }, function (data) {
            if (data) {
                alert("Cập nhật thành công");
            } else {
                alert("Quá trình thực hiện không thành công. Hãy thử lại");
            }
        });
    }

    function updateWard(id) {
        var divId = $("tr[data-id='" + id + "']");
        var sort = divId.find("input[name=WardSort]").val();
        var active = divId.find("input#ward_WardActive").prop("checked");
        var shipFee = parseInt(divId.find("input[name=ShipFee]").val().replace(/,/g, '')) || 0;
        console.log(shipFee);

        $.post("/Vcms/UpdateWard", { wardId: id, sort, active, shipFee }, function (data) {
            if (data) {
                alert("Cập nhật thành công");
            } else {
                alert("Quá trình thực hiện không thành công. Hãy thử lại");
            }
        });
    }

</script>

