    const input = document.getElementById("ShipFee");
    const MAX_VALUE = 10000000; 

    function formatNumberWithCommas(str) {
        const num = str.replace(/,/g, '');
        if (isNaN(num) || num === '') return '';
        return parseInt(num, 10).toLocaleString('en-US');
    }

    function unformatNumber(str) {
        return str.replace(/,/g, '');
    }

    input.addEventListener("input", function () {
        let raw = unformatNumber(this.value);

        // Nếu không phải số, reset luôn
        if (isNaN(raw) || raw === '') {
            this.value = '';
            return;
        }

        // Chặn nếu vượt quá giới hạn
        if (parseInt(raw) > MAX_VALUE) {
            alert("Không được nhập quá 10,000,000");
            raw = MAX_VALUE.toString();
        }

        // Format lại
        this.value = formatNumberWithCommas(raw);

        // Đưa con trỏ về cuối
        this.setSelectionRange(this.value.length, this.value.length);
    });
</script>

