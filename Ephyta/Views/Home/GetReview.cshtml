@*@model PagedList.IPagedList<Ephyta.Models.Review>*@

@model Ephyta.ViewModel.GetReviewViewModel
@using PagedList.Mvc
@{
    var img = "data:image/gif;base64,R0lGODlhAQABAIAAAAUEBAAAACwAAAAAAQABAAACAkQBADs=";
    Layout = null;
}
@foreach (var review in Model.Reviews)
{
    <div class="reviews-item">
        <div class="body">
            <div class="left">
                <div class="avata">
                    @if (review.ImageAvata != null)
                    {
                        <img src="@Path.Combine("/images/reviews/", review.ImageAvata.Split(',')[0])" class="" alt="@review.Name" />
                    }
                    else
                    {
                        <img src="~/Content/images/no-avata.png" class="" alt="No Picture"/>

                    }
                </div>
                <div class="occ">
                    <div class="name">@review.Name</div>
                    <div class="date">@review.CreateDate.ToString("dd/MM/yyyy")</div>
                    <div class="stars">
                        <i class="fas fa-star @if (Convert.ToInt32(review.StarReview) >= 1) { @Html.Raw("active")}"></i>
                        <i class="fas fa-star @if (Convert.ToInt32(review.StarReview) >= 2) { @Html.Raw("active")}"></i>
                        <i class="fas fa-star @if (Convert.ToInt32(review.StarReview) >= 3) { @Html.Raw("active")} "></i>
                        <i class="fas fa-star @if (Convert.ToInt32(review.StarReview) >= 4) { @Html.Raw("active")}"></i>
                        <i class="fas fa-star @if (Convert.ToInt32(review.StarReview) == 5) { @Html.Raw("active")}"></i>
                    </div>
                </div>
            </div>
            <div class="right">
                <div class="content">
                    @review.Content
                </div>
                @if (review.ListImage != null)
                {
                    var arr = review.ListImage.Split(',');
                    <div class="list-img">
                        @foreach (var item in arr)
                        {
                            <a href="@Path.Combine("/images/reviews/", item)" data-fancybox="gallery-@review.Id">
                                <img data-src="@Path.Combine("/images/reviews/", item)?w=600" alt="@review.Name" class="img-responsive lazyload" src="@img" />
                            </a>

                        }
                    </div>

                }
            </div>
        </div>
    </div>
    @*<div>@review.Name</div>*@
}
@*Page @(Model.Reviews.PageCount < Model.Reviews.PageNumber ? 0 : Model.Reviews.PageNumber) of @Model.Reviews.PageCount*@

@if (Model.Reviews.PageCount > 1)
{
    <div id="contentPager">
        @Html.PagedListPager(Model.Reviews, page => Url.Action("GetReview", new { page, id = Model.Id }))
    </div>
}